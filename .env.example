NODE_ENV=development
AURELIS_API_PORT=3000
AURELIS_BATCH_PORT=3001
MONGODB_URI=mongodb://127.0.0.1:27017/aurelis
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace-with-a-long-random-secret
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# MONGO_DEV/MONGO_PROD and SECRET_TOKEN are obsolete names. Set MONGODB_URI
# and JWT_SECRET explicitly; preserve the intended existing database/secret.
# GOOGLE_CLIENT_ID is needed for googleLogin; other auth does not require it.
# No upload endpoint/storage is configured. Image fields accept existing URLs.

# Quotas, cache TTL (30s), presence TTL (60s), typing TTL (5s),
# websocket transport and socket packet limits are fixed code policies, not env knobs.
# REDIS_URL supports redis:// or rediss://; supply real credentials only outside Git.
